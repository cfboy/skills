# Local development: `pnpm dev:setup` writes .env.local for you from the
# running Supabase stack. This file documents what each variable is for; the
# app validates them at boot (lib/env.ts).

# Supabase's Data API (PostgREST). Every app read and write goes through it
# with a token minted for the signed-in user, so RLS decides what comes back.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:__API_PORT__
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Scripts only (fixtures, rls-check). Bypasses RLS. Never in the browser,
# never imported by app code (ESLint enforces it).
SUPABASE_URL=http://127.0.0.1:__API_PORT__
SUPABASE_SECRET_KEY=

# The direct Postgres connection: BetterAuth's tables and identity lookups.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:__DB_PORT__/postgres

# The private ES256 JWK the server signs Supabase tokens with, on one line.
# Locally: `pnpm keys:ensure --print`. Production: the key imported under
# Supabase → Project Settings → JWT Keys.
SUPABASE_JWT_SIGNING_KEY=

# BetterAuth.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Outgoing email over SMTP. Locally, the Mailpit `supabase start` runs
# (inbox at http://127.0.0.1:__MAIL_PORT__).
SMTP_URL=smtp://127.0.0.1:__SMTP_PORT__
EMAIL_FROM="__APP_NAME__ <no-reply@example.com>"
